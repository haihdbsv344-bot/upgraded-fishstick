// package.json
{
  "name": "vip-tx-analysis",
  "version": "2.0.0",
  "description": "Thuật toán phân tích Tài Xỉu VIP cực mạnh với AI và Neural Network - @tranhoang2286",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "pm2": "pm2 start server.js --name vip-tx",
    "pm2-stop": "pm2 stop vip-tx",
    "pm2-restart": "pm2 restart vip-tx"
  },
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "crypto": "^1.0.1",
    "fs": "^0.0.1-security",
    "path": "^0.12.7",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "rate-limit-flexible": "^2.4.1",
    "winston": "^3.11.0",
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.52.0",
    "prettier": "^3.0.3"
  },
  "keywords": [
    "tai-xiu",
    "analysis",
    "vip",
    "neural-network",
    "ai",
    "prediction",
    "machine-learning",
    "deep-learning",
    "gambling",
    "algorithm"
  ],
  "author": "@tranhoang2286",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tranhoang2286/vip-tx-analysis"
  },
  "bugs": {
    "url": "https://github.com/tranhoang2286/vip-tx-analysis/issues"
  },
  "homepage": "https://github.com/tranhoang2286/vip-tx-analysis#readme",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": 2021
    },
    "rules": {
      "indent": ["error", 4],
      "linebreak-style": ["error", "unix"],
      "quotes": ["error", "single"],
      "semi": ["error", "always"],
      "no-unused-vars": ["warn"],
      "no-console": ["warn", { "allow": ["log", "error", "warn"] }]
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "printWidth": 100
  }
}
